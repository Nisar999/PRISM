# Code-OSS web workbench.
# Default (unset): same-origin Vite proxy → http://127.0.0.1:1420/__code-oss/ → :8080
# VITE_CODE_OSS_WORKBENCH_URL=http://127.0.0.1:8080/

# Optional: iframe the workbench URL directly (skips protocol host).
# VITE_CODE_OSS_URL=http://127.0.0.1:8080/

# Optional: force Sprint 4A proof bridge instead of Code-OSS web host.
# VITE_EDITOR_HOST=bridge

# Optional: override the Ollama probe base URL (default probes 127.0.0.1:11434/11435).
# VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: override the LM Studio probe base URL (default probes 127.0.0.1:1234).
# VITE_LMSTUDIO_BASE_URL=http://127.0.0.1:1234

# Optional: comma-separated list of additional OpenAI-compatible endpoints to
# auto-discover at startup (each must expose /v1/models).
# VITE_OPENAI_COMPATIBLE_ENDPOINTS=http://127.0.0.1:5001,http://127.0.0.1:8000/v1

