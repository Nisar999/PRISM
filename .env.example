# PRISM Docker Compose environment
# Copy to repo root as `.env`:
#   cp .env.example .env
#
# This file uses Docker service hostnames (postgres, redis, …).
# For running the API on the host against Docker infra, see backend/.env.example.

# Application
PRISM_ENV=development
PRISM_DEBUG=true
PRISM_SECRET_KEY=change-me-in-production

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=prism
POSTGRES_PASSWORD=prism_secret
POSTGRES_DB=prism

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=prism_neo4j_secret

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=prism_memories

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Ollama (in-compose service name; host-mapped port is 11435 → container 11434)
OLLAMA_BASE_URL=http://ollama:11434

# LM Studio (local host machine reachable from containers)
LMSTUDIO_BASE_URL=http://host.docker.internal:1234

# LLM Provider API Keys (never commit real keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# LiteLLM
LITELLM_DEFAULT_MODEL=ollama/llama3.2
LITELLM_FALLBACK_MODEL=openrouter/meta-llama/llama-3.2-3b-instruct:free
LITELLM_EMBEDDING_MODEL=ollama/nomic-embed-text

# Worker
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Optional observability
GRAFANA_PASSWORD=prism_admin
