# Local backend development (uvicorn on the host)
# Copy to backend/.env:
#   cp backend/.env.example backend/.env
#
# Use these localhost hosts when Docker Compose provides infra
# but the API runs outside containers:
#   docker compose up -d postgres neo4j qdrant redis ollama

PRISM_ENV=development
PRISM_DEBUG=false
PRISM_SECRET_KEY=change-me-in-production

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=prism
POSTGRES_PASSWORD=prism_secret
POSTGRES_DB=prism

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=prism_neo4j_secret

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=prism_memories

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Host-mapped Ollama port from docker/docker-compose.yml (11435:11434)
OLLAMA_BASE_URL=http://localhost:11435
LMSTUDIO_BASE_URL=http://localhost:1234

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

LITELLM_DEFAULT_MODEL=ollama/llama3.2
LITELLM_FALLBACK_MODEL=openrouter/meta-llama/llama-3.2-3b-instruct:free
LITELLM_EMBEDDING_MODEL=ollama/nomic-embed-text

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
